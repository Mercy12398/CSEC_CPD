#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;
    int count = 0;

    for (int i = 0; i < n; i++) {
        int petya, vasya, tonya;
        cin >> petya >> vasya >> tonya;

        // Check if at least two friends are sure about the solution
        if (petya + vasya + tonya >= 2) {
            count++;
        }
    }

    cout << count << endl;  // Print the number of problems they will implement
    return 0;
}
