#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;
    string s;
    cin >> s;
    int antonwins = 0; 
    int danikwins = 0;

    for (char c : s) {
        if (c == 'A') {
            antonwins++;
        } else if (c == 'D') {
            danikwins++;
        }
    }

    if (antonwins > danikwins) {
        cout << "Anton";
    } else if (danikwins > antonwins) {
        cout << "Danik";
    } else {
        cout << "Friendship";
    }

    return 0;
}
